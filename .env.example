PORT=8787
HOST=127.0.0.1

# Optional. The server auto-reads .insforge/project.json after `npx @insforge/cli link`.
# Set USE_LOCAL_STORE=true to force local JSON persistence.
USE_LOCAL_STORE=false
INSFORGE_URL=
INSFORGE_API_KEY=
INSFORGE_ANON_KEY=

# Gemini API — used for pitch generation, answer evaluation, social post text, and final report.
GEMINI_API_KEY=

# Image generation — used for social post visuals (Gemini Imagen or similar).
IMAGE_GEN_API_KEY=

# Optional integration endpoints owned by teammates.
MEMOIR_API_URL=
MEMOIR_API_KEY=
REPLICAS_API_URL=
REPLICAS_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY=
